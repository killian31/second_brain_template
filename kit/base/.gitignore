# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~

# If you add an Obsidian-style editor on top, its local workspace state is
# machine-specific and shouldn't sync — but plugin config you *want* synced
# (community-plugins.json, etc.) is fine to keep, so only workspace files are
# ignored here, not the whole .obsidian/ folder.
.obsidian/workspace*.json
.obsidian/cache

# Generated by 00_Meta/scripts/build_index.py. Each machine rebuilds its own;
# tracking it makes two syncing machines conflict on every run.
INDEX.md
